{
  "info": {
    "_postman_id": "9f6e73af-60a2-4ce5-9ed1-556ab8c954b8",
    "name": "Hostel Mess API",
    "description": "Run the folders in order with the Collection Runner. Pick the Hostel Mess - Local environment first. Folder 0 logs in and saves the tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 Setup (run first)",
      "item": [
        {
          "name": "00 Generate dates + register student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\":\"Test Student\",\"email\":\"{{studentEmail}}\",\"password\":\"{{studentPassword}}\",\"roomNo\":\"A-101\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Generates fresh test dates for this run, then registers the test student. 409 means the student already exists, which is fine."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function plus(n){var d=new Date();d.setUTCDate(d.getUTCDate()+n);return d.toISOString().slice(0,10);}",
                  "var a=3+Math.floor(Math.random()*20);",
                  "var m=plus(2+Math.floor(Math.random()*25));",
                  "var b=40+Math.floor(Math.random()*200);",
                  "pm.environment.set(\"mealDate\",m);",
                  "pm.environment.set(\"mealMonth\",String(parseInt(m.slice(5,7),10)));",
                  "pm.environment.set(\"mealYear\",m.slice(0,4));",
                  "pm.environment.set(\"leave1From\",plus(a));",
                  "pm.environment.set(\"leave1To\",plus(a+2));",
                  "pm.environment.set(\"overlapFrom\",plus(a+1));",
                  "pm.environment.set(\"overlapTo\",plus(a+5));",
                  "pm.environment.set(\"leave2From\",plus(b));",
                  "pm.environment.set(\"leave2To\",plus(b+2));",
                  "pm.environment.set(\"pastFrom\",plus(-20));",
                  "pm.environment.set(\"pastTo\",plus(-19));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 (new) or 409 (already registered)\", function () { pm.expect([201,409]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "01 Login admin (saves adminToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Role is ADMIN\", function () { pm.expect(j.role).to.eql(\"ADMIN\"); });",
                  "pm.environment.set(\"adminToken\", j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login student (saves studentToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{studentEmail}}\",\"password\":\"{{studentPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Role is STUDENT\", function () { pm.expect(j.role).to.eql(\"STUDENT\"); });",
                  "pm.environment.set(\"studentToken\", j.token);"
                ]
              }
            }
          ]
        }
      ]
    },
