  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get(\"mealDate\")) {",
          "function plus(n){var d=new Date();d.setUTCDate(d.getUTCDate()+n);return d.toISOString().slice(0,10);}",
          "var a=3+Math.floor(Math.random()*20);",
          "var m=plus(2+Math.floor(Math.random()*25));",
          "var b=40+Math.floor(Math.random()*200);",
          "pm.environment.set(\"mealDate\",m);",
          "pm.environment.set(\"mealMonth\",String(parseInt(m.slice(5,7),10)));",
          "pm.environment.set(\"mealYear\",m.slice(0,4));",
          "pm.environment.set(\"leave1From\",plus(a));",
          "pm.environment.set(\"leave1To\",plus(a+2));",
          "pm.environment.set(\"overlapFrom\",plus(a+1));",
          "pm.environment.set(\"overlapTo\",plus(a+5));",
          "pm.environment.set(\"leave2From\",plus(b));",
          "pm.environment.set(\"leave2To\",plus(b+2));",
          "pm.environment.set(\"pastFrom\",plus(-20));",
          "pm.environment.set(\"pastTo\",plus(-19));",
          "}"
        ]
      }
    }
  ]
