# Copy to .env (never commit .env) or export these as real environment variables.

# JDBC URL: local PostgreSQL for development, RDS endpoint in production
# Local : jdbc:postgresql://localhost:5432/hostel_mess
# AWS   : jdbc:postgresql://<rds-endpoint>:5432/hostel_mess
DB_URL=jdbc:postgresql://localhost:5432/hostel_mess
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Long random string, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret
# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Frontend origin, needed only for local development (VS Code Live Server)
CORS_ALLOWED_ORIGIN=http://127.0.0.1:5500
